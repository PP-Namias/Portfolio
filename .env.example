# Dual Hosting Environment Variables
# Shared between V1 (Vercel) and V2 (Cloudflare)

# === Sanity CMS (Shared) ===
NEXT_PUBLIC_SANITY_PROJECT_ID=nl0qw78w
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your_sanity_api_read_token
SANITY_REVALIDATE_SECRET=your_revalidation_secret
SANITY_MEDIA_GATEWAY_SECRET=your_media_gateway_secret

# === V1 (Vercel) Specific ===
# Analytics
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your_umami_website_id
NEXT_PUBLIC_UMAMI_DOMAINS=namias.tech

# Cal.com
NEXT_PUBLIC_CAL_LINK=pp-namias

# Sentry
SENTRY_DSN=your_sentry_dsn
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# === V2 (Cloudflare) Specific ===
# Analytics
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=your_openpanel_client_id

# === Deployment ===
# Vercel (V1)
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id

# Cloudflare (V2)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# === AI Chatbot providers (portfolio-v1 /api/chat) ===
# Failover order; the first configured, circuit-closed provider answers.
CHAT_PROVIDER_ORDER=claude,gemini,openai

# Claude (primary generator)
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_FALLBACK_MODEL=claude-opus-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# standard | fast — fast mode only applies to claude-opus-5 / claude-opus-4-8
CLAUDE_SPEED=standard

# Gemini (failover generator, and the ONLY embedding provider for RAG)
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key

# OpenAI (last-resort generator; also requires CHAT_MULTI_PROVIDER_ENABLED)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
CHAT_MULTI_PROVIDER_ENABLED=false

# === RAG vector store (Upstash) ===
UPSTASH_VECTOR_URL=your_upstash_vector_url
UPSTASH_VECTOR_TOKEN=your_upstash_vector_token
REINDEX_SECRET=your_reindex_secret
