# Google Gemini API Key (get from https://aistudio.google.com/apikey)
# Private server secret (never expose or commit real values)
GOOGLE_GEMINI_API_KEY=your_key_here

# Optional durable rate limiting (Upstash Redis — private server secrets)
# If unset, rate limiting falls back to in-memory (per-instance, not shared)
UPSTASH_REDIS_REST_URL=your_upstash_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Sanity CMS — shared across app + Studio
# Public client variables (safe to expose in browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=nl0qw78w
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_STUDIO_URL=https://namias-cms.sanity.studio
NEXT_PUBLIC_SITE_URL=https://namias.tech

# Sanity CMS — private server-side tokens
SANITY_REVALIDATE_SECRET=your_revalidate_secret
SANITY_API_READ_TOKEN=your_sanity_read_token
SANITY_MEDIA_GATEWAY_SECRET=your_media_gateway_secret

# Sanity CMS — Studio deployment and roles
SANITY_STUDIO_PROJECT_ID=your_sanity_studio_project_id
SANITY_STUDIO_DATASET=your_sanity_studio_dataset
SANITY_STUDIO_URL=your_sanity_studio_url
SANITY_STUDIO_DEPLOY_TOKEN=your_studio_deploy_token
SANITY_CUTOVER_ENABLED=true

# Chat — multi-provider failover (optional)
CHAT_MULTI_PROVIDER_ENABLED=false
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Chat reliability tuning
CHAT_PROVIDER_TIMEOUT_MS=12000
CHAT_PROVIDER_MAX_RETRIES=1
CHAT_PROVIDER_RETRY_BASE_MS=220
CHAT_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=4
CHAT_PROVIDER_CIRCUIT_COOLDOWN_MS=60000

# Umami analytics (optional; enable only when values are set)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your_umami_website_id
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_HOST_URL=https://api-gateway.umami.dev
NEXT_PUBLIC_UMAMI_DOMAINS=namias.tech

# Cloudflare deployment (use GitHub Actions secrets, not .env)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=4bd772a73fb69e405e81422ee07a34a6

# Security hardening — rate-limiter namespace config
# (leave as defaults unless you need custom limits)
RATE_LIMIT_CHAT=10
RATE_LIMIT_RESUME=30
RATE_LIMIT_MEDIA=100
RATE_LIMIT_WEBHOOK=5
RATE_LIMIT_LIVE=5
RATE_LIMIT_DRAFT_MODE=5
