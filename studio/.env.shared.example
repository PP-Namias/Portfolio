# Namias CMS — Shared Environment Variables
# This file documents all environment variables needed by the shared Sanity CMS studio.
# Copy to .env.local in the studio/ directory and fill in the values.

# =============================================================================
# STUDIO CONFIGURATION
# =============================================================================

# Sanity Project ID (shared by both v1 and v2)
SANITY_STUDIO_PROJECT_ID=nl0qw78w

# Sanity Dataset (shared by both v1 and v2)
SANITY_STUDIO_DATASET=production

# Sanity API Read Token (for authenticated requests from studio)
SANITY_API_READ_TOKEN=

# Revalidation Secret (for webhook-triggered cache invalidation)
SANITY_STUDIO_REVALIDATE_SECRET=

# Site URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# =============================================================================
# PORTFOLIO V1 CONSUMER
# =============================================================================

# V1 uses these env vars in portfolio-v1/.env.local:
# NEXT_PUBLIC_SANITY_PROJECT_ID=nl0qw78w
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=
# SANITY_REVALIDATE_SECRET=

# =============================================================================
# PORTFOLIO V2 CONSUMER
# =============================================================================

# V2 uses these env vars in portfolio-v2/.env.local:
# NEXT_PUBLIC_SANITY_PROJECT_ID=nl0qw78w
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=
# SANITY_REVALIDATE_SECRET=
