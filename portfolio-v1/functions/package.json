{
  "name": "@pp-namias/sanity-functions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sanity Functions for the Namias CMS showcase (scheduled-publish, broken-refs, auto-tag-images).",
  "scripts": {
    "deploy": "npx sanity@latest blueprints deploy",
    "plan": "npx sanity@latest blueprints plan",
    "logs": "npx sanity@latest blueprints logs",
    "destroy": "npx sanity@latest blueprints destroy",
    "test:scheduled-publish": "npx sanity@latest functions test scheduled-publish --data '{}'",
    "test:broken-refs": "npx sanity@latest functions test broken-refs --data '{}'",
    "test:auto-tag-images": "npx sanity@latest functions test auto-tag-images --data '{\"data\":{\"asset\":{\"_id\":\"image-abc123\",\"url\":\"https://example.com/x.jpg\"}}}'"
  },
  "dependencies": {
    "@sanity/client": "^7.6.0",
    "@sanity/functions": "^1.0.0",
    "sanity": "^4.22.0"
  }
}
