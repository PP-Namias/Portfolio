# Vercel Environment Variables for Portfolio V1
# Copy these to Vercel Dashboard → Settings → Environment Variables

# === Sanity CMS (Shared with V2) ===
NEXT_PUBLIC_SANITY_PROJECT_ID=nl0qw78w
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your_sanity_api_read_token
SANITY_REVALIDATE_SECRET=your_revalidation_secret
SANITY_MEDIA_GATEWAY_SECRET=your_media_gateway_secret

# === Analytics (V1-specific) ===
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your_umami_website_id
NEXT_PUBLIC_UMAMI_DOMAINS=namias.tech

# === Cal.com Booking ===
NEXT_PUBLIC_CAL_LINK=pp-namias

# === Sentry Error Tracking ===
SENTRY_DSN=your_sentry_dsn
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# === Vercel (Auto-configured) ===
# VERCEL_ORG_ID (auto)
# VERCEL_PROJECT_ID (auto)
