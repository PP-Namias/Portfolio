# ─────────────────────────────────────────────
# Namias Portfolio — Environment Variables
# Copy to .env.local and fill in real values
# NEVER commit .env.local to git (it is gitignored)
# For Vercel: set these in Dashboard → Settings → Environment Variables
# ─────────────────────────────────────────────

# Site URL (used for SEO/OG images, Sanity studio preview, webhook callbacks)
# Local dev: http://localhost:3000  |  Production: https://namias.tech
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity CMS ─────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=nl0qw78w
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=nl0qw78w
SANITY_STUDIO_DATASET=production
SANITY_CUTOVER_ENABLED=true
SANITY_API_READ_TOKEN=your_sanity_read_token
SANITY_API_WRITE_TOKEN=your_sanity_write_token
SANITY_REVALIDATE_SECRET=your_revalidate_secret
# IMPORTANT: SANITY_MEDIA_GATEWAY_SECRET must also be set as a Cloudflare Worker secret.
# Set it via: npx wrangler secret put SANITY_MEDIA_GATEWAY_SECRET
# Or via Cloudflare Dashboard > Workers > namias > Settings > Variables > Secrets
SANITY_MEDIA_GATEWAY_SECRET=your_media_gateway_secret
SANITY_STUDIO_DEPLOY_TOKEN=your_studio_deploy_token
SANITY_ACCESS_MANAGER_TOKEN=your_access_manager_token
SANITY_BLUEPRINTS_DEPLOYER_TOKEN=your_blueprints_deployer_token
SANITY_CONTRIBUTOR_TOKEN=your_contributor_token
SANITY_EDITOR_TOKEN=your_editor_token
SANITY_VIEWER_TOKEN=your_viewer_token
SANITY_DEVELOPER_TOKEN=your_developer_token

# Umami Analytics ────────────────────────────
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your_umami_website_id
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_HOST_URL=https://api-gateway.umami.dev
NEXT_PUBLIC_UMAMI_DOMAINS=namias.tech

# Chat (Gemini / OpenAI) — optional for local dev
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key
CHAT_MULTI_PROVIDER_ENABLED=false
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_PROVIDER_TIMEOUT_MS=12000
CHAT_PROVIDER_MAX_RETRIES=1
CHAT_PROVIDER_RETRY_BASE_MS=220
CHAT_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=4
CHAT_PROVIDER_CIRCUIT_COOLDOWN_MS=60000

# Caching (optional)
CACHE_TTL_DEFAULT=300000
CACHE_TTL_STALE=60000

# Admin API key — required for /api/performance/cache, /api/canary/test, /api/canary/stats
ADMIN_API_KEY=your_admin_api_key

# ─────────────────────────────────────────────
# Vercel Deployment Notes
# ─────────────────────────────────────────────
# 1. NEVER put real secrets in this file — use .env.local (gitignored)
# 2. For Vercel: set all variables in the dashboard, not in files
# 3. Rotate ALL tokens if they were ever exposed in git history
# 4. SANITY_MEDIA_GATEWAY_SECRET must match the Cloudflare Worker secret
#    if using Cloudflare Workers alongside Vercel
# ─────────────────────────────────────────────
