  "summary": "Integrate Graphify knowledge graph tool to create an interactive codebase visualization and architecture explorer. Generates a queryable knowledge graph of the entire portfolio codebase, powers a new 'Codebase Explorer' section with interactive graph visualization, and provides architectural insights through god nodes, community detection, and relationship mapping.",
  "designReference": {
    "description": "Interactive knowledge graph visualization showing codebase architecture, relationships between components, and key concepts. Dark theme with glowing nodes, animated edges, and community-colored clusters.",
    "graphExplorerPage": {
      "heading": "Codebase Explorer",
      "subheading": "Interactive Knowledge Graph",
      "layout": "Full-width graph visualization with sidebar controls",
      "features": [
        "Interactive D3.js force-directed graph",
        "Click nodes to view details",
        "Filter by file type, community, or relationship",
        "Search functionality",
        "Zoom/pan controls",
        "Mini-map for navigation"
      ]
    },
    "architectureSection": {
      "heading": "Architecture Insights",
      "subheading": "Key concepts and relationships",
      "layout": "Card grid with god nodes, communities, and suggested questions",
      "features": [
        "God nodes display (most-connected concepts)",
        "Community clusters with names",
        "Suggested questions from graph analysis",
        "Confidence tags (EXTRACTED, INFERRED, AMBIGUOUS)"
      ]
    }
  },
  "principles": [
    "Commit-per-slice: every change gets its own commit",
    "Feature-flagged: IS_GRAPHIFY_ENABLED gates everything",
    "Accessible: keyboard nav, focus rings, reduced-motion",
    "Testable: every component has tests",
    "Performance: lazy-load graph visualization, use WebGL for large graphs",
    "Privacy: code processed locally, no external API calls for AST extraction",
    "Progressive enhancement: fallback to static report if graph fails to load"
  ],
