/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# SW must never be cached
/sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /

# Icons are immutable
/icons/*
  Cache-Control: public,max-age=31536000,immutable

# Manifest revalidates daily
/site.webmanifest
  Cache-Control: public,max-age=86400
