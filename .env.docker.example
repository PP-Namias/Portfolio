# ═══════════════════════════════════════════════════════════════
# Docker Services - Environment Variables
# Copy to .env.docker and fill in real values
# ═══════════════════════════════════════════════════════════════

# ─── Shared Sanity CMS ─────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=nl0qw78w
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# ─── Portfolio V1 ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3001
SANITY_STUDIO_PROJECT_ID=nl0qw78w
SANITY_STUDIO_DATASET=production
GOOGLE_GEMINI_API_KEY=
ADMIN_API_KEY=

# ─── Portfolio V2 ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3002
GITHUB_CONTRIBUTIONS_API_URL=https://github-contributions-api.jogruber.de
GITHUB_API_TOKEN=

# ─── Sanity Studio ─────────────────────────────────────────────
# Uses NEXT_PUBLIC_SANITY_PROJECT_ID and NEXT_PUBLIC_SANITY_DATASET from above
# SANITY_STUDIO_PROJECT_ID and SANITY_STUDIO_DATASET are auto-derived

# ─── Analytics (Optional) ──────────────────────────────────────
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_HOST_URL=https://api-gateway.umami.dev
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
