# Docker Services - Environment Variables
# Copy to .env.docker and fill in real values.
# Never commit .env.docker (gitignored).

# Shared Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=nl0qw78w
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Portfolio V1
NEXT_PUBLIC_SITE_URL=http://localhost:8080
ADMIN_API_KEY=

# AI Service (Hono + LangGraph microservice)
AI_SERVICE_PORT=8787
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
AI_SERVICE_TRUST_PROXY=1
AI_SERVICE_REINDEX_SECRET=
GOOGLE_GEMINI_API_KEY=
UPSTASH_VECTOR_URL=
UPSTASH_VECTOR_TOKEN=

# AI models & RAG tuning (optional overrides)
AI_LLM_MODEL=gemini-2.5-flash
AI_LLM_FALLBACK_MODEL=gemini-1.5-pro
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=768
AI_RAG_TOP_K=6
AI_RAG_SIMILARITY_THRESHOLD=0.6
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.3

# Sanity Studio (auto-derived from NEXT_PUBLIC_SANITY_*)
SANITY_STUDIO_PROJECT_ID=nl0qw78w
SANITY_STUDIO_DATASET=production

# Analytics (optional)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_HOST_URL=https://api-gateway.umami.dev
