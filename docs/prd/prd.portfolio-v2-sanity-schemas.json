    {
      "id": "EPIC-E",
      "title": "GROQ Queries",
      "priority": "high",
      "stories": [
        {
          "id": "SE.1",
          "title": "Profile query",
          "query": "*[_type == \"profile\"][0]{firstName, lastName, displayName, username, title, email, phone, location, website, dailyDev, avatar, about, aboutText, socialLinks[]->, education[]->, availability, resumeUrl}"
        },
        {
          "id": "SE.2",
          "title": "SiteSettings query",
          "query": "*[_type == \"siteSettings\"][0]{siteTitle, siteDescription, ogImage, favicon, accentColor, footerText, ga4Id, posthogToken, openpanelClientId}"
        },
        {
          "id": "SE.3",
          "title": "All projects query",
          "query": "*[_type == \"project\"] | order(order asc, featured desc, title asc){title, slug, summary, description, category, technologies, image, gallery, liveUrl, repoUrl, featured, order, status}"
        },
        {
          "id": "SE.4",
          "title": "Experiences query",
          "query": "*[_type == \"experience\"] | order(order asc, startDate desc){role, company, location, startDate, endDate, employmentType, description, skills, highlights, order}"
        },
        {
          "id": "SE.5",
          "title": "Certifications query",
          "query": "*[_type == \"certification\"] | order(order asc, issuedAt desc){title, issuer, issuedAt, expiresAt, credentialUrl, category->, image, order}"
        },
        {
          "id": "SE.6",
          "title": "Education query",
          "query": "*[_type == \"education\"] | order(startYear desc){institution, degree, field, startYear, endYear, gpa, honors, activities}"
        },
        {
          "id": "SE.7",
          "title": "Social links query",
          "query": "*[_type == \"socialLink\"] | order(isPrimary desc, platform asc){platform, handle, url, isPrimary}"
        },
        {
          "id": "SE.8",
          "title": "Testimonials query",
          "query": "*[_type == \"testimonial\"] | order(featured desc, _createdAt asc){quote, author, role, company, avatar, rating, featured}"
        },
        {
          "id": "SE.9",
          "title": "Awards query",
          "query": "*[_type == \"award\"] | order(date desc){title, prize, date, category, description, url, image}"
        },
        {
          "id": "SE.10",
          "title": "Bookmarks query",
          "query": "*[_type == \"bookmark\"] | order(category asc, title asc){title, url, description, category, favicon}"
        },
        {
          "id": "SE.11",
          "title": "Tech stack query",
          "query": "*[_type == \"techStack\"][0]{title, technologies[]{name, icon, category, proficiency, url}}"
        },
        {
          "id": "SE.12",
          "title": "Published posts query",
          "query": "*[_type == \"post\" && published == true && defined(slug.current)] | order(publishedAt desc){title, slug, excerpt, mainImage, publishedAt, categories[]->, tags[]}"
        }
      ]
    },
