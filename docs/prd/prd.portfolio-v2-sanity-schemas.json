  "schemaRelationships": {
    "profile": {
      "hasMany": ["socialLink", "education"],
      "references": "socialLink[], education[]"
    },
    "project": {
      "hasMany": ["category"],
      "references": "category (via string, not reference)"
    },
    "certification": {
      "hasMany": ["category"],
      "references": "category (reference)"
    },
    "post": {
      "hasMany": ["category"],
      "references": "category[] (reference)"
    }
  },

  "dataMigrationPlan": {
    "step1": "Export current hardcoded data from v2 TypeScript files",
    "step2": "Create Sanity documents from exported data",
    "step3": "Import into Sanity dataset via sanity dataset import",
    "step4": "Verify data matches hardcoded values",
    "step5": "Switch components to fetch from Sanity",
    "step6": "Remove hardcoded data files (keep as fallback)"
  }
