  "commitPlan": {
    "strategy": "One commit per slice. Each commit is self-contained and passes all checks.",
    "checksPerCommit": ["npx tsc --noEmit", "npm run lint", "npx vitest run"]
  },
  "dependencies": [
    {
      "name": "@radix-ui/react-dialog",
      "version": "^1.0.0",
      "purpose": "Modal dialog primitive for shadcn/ui"
    },
    {
      "name": "@radix-ui/react-slot",
      "version": "^1.0.0",
      "purpose": "Component composition for shadcn/ui"
    },
    {
      "name": "class-variance-authority",
      "version": "^0.7.0",
      "purpose": "Variant management for shadcn/ui"
    },
