      "description": "Controls shadcn/ui component usage"
    },
    {
      "name": "IS_MAGIC_UI_ENABLED",
      "defaultValue": true,
      "description": "Controls Magic UI animated components"
    },
    {
      "name": "IS_REACT_SCAN_ENABLED",
      "defaultValue": true,
      "description": "Controls React Scan performance monitoring"
    },
    {
      "name": "IS_UPSTASH_RATE_LIMIT_ENABLED",
      "defaultValue": false,
      "description": "Controls Upstash rate limiter"
    },
    {
      "name": "IS_SENTRY_ENABLED",
      "defaultValue": true,
      "description": "Controls Sentry error tracking"
