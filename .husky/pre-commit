#!/bin/sh
echo "[hooks] Running pre-commit checks..."

# 1. Lint + format staged files only (ESLint --fix + Prettier --write)
#    Scoped strictly to staged files via lint-staged for fast commits.
echo "[hooks] Running lint-staged..."
cd portfolio-v1 && npx lint-staged
if [ $? -ne 0 ]; then
  echo "[hooks] lint-staged failed. Fix the issues above and try again."
  exit 1
fi
cd ..

# 2. Secret scanning with gitleaks (optional; only runs if installed)
if command -v gitleaks >/dev/null 2>&1; then
  echo "[hooks] Running gitleaks secret scan..."
  gitleaks detect --source . --verbose --redact
  if [ $? -ne 0 ]; then
    echo "[hooks] gitleaks detected secrets! Remove them before committing."
    exit 1
  fi
else
  echo "[hooks] Skipping gitleaks (not installed). Install via: scoop install gitleaks"
fi

echo "[hooks] All pre-commit checks passed."
