{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namias",
  "main": "portfolio-v1/.open-next/worker.js",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "build": {
    "command": "cd portfolio-v1 && npm ci && npx opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion"
  },
  "assets": {
    "directory": "portfolio-v1/.open-next/assets",
    "binding": "ASSETS"
  }
}