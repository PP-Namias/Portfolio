# ─────────────────────────────────────────────
# AI Service — Environment Variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to git (gitignored).
# All variables support the repo's existing names;
# spec names (SANITY_PROJECT_ID / SANITY_DATASET /
# SANITY_API_TOKEN) are honored as fallbacks.
# ─────────────────────────────────────────────

# Sanity CMS ────────────────────────────────
# Existing repo convention (already set in root .env.local):
NEXT_PUBLIC_SANITY_PROJECT_ID=nl0qw78w
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your_sanity_read_token
# Spec-name fallbacks (optional, take precedence if set):
# SANITY_PROJECT_ID=nl0qw78w
# SANITY_DATASET=production
# SANITY_API_TOKEN=your_sanity_read_token

# Google Gemini ─────────────────────────────
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key

# Upstash Vector (RAG index) ────────────────
UPSTASH_VECTOR_URL=https://your-db.upstash.io
UPSTASH_VECTOR_TOKEN=your_upstash_vector_token

# Service ───────────────────────────────────
AI_SERVICE_PORT=8787
AI_SERVICE_HOST=0.0.0.0
# Comma-separated allowed origins for CORS (frontend UI)
AI_SERVICE_CORS_ORIGINS=http://localhost:3000
# Admin guard for reindex endpoints (repo fallback: REINDEX_SECRET)
AI_SERVICE_REINDEX_SECRET=your_reindex_secret

# Models ────────────────────────────────────
AI_LLM_MODEL=gemini-2.5-flash
AI_LLM_FALLBACK_MODEL=gemini-1.5-pro
# gemini-embedding-001 with outputDimensionality matching the 768d Upstash index
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=768

# RAG tuning ────────────────────────────────
AI_RAG_TOP_K=6
AI_RAG_SIMILARITY_THRESHOLD=0.6
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.3
