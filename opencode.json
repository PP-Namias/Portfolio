{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "description": "Browser debugging, performance traces, screenshots, console inspection"
    },
    "@21st-dev/magic": {
      "type": "local",
      "command": ["npx", "-y", "@21st-dev/magic@latest"],
      "env": {
        "API_KEY": "${API_KEY_21ST_DEV}"
      },
      "description": "Generate UI components from natural language (requires API key)"
    },
    "@magicuidesign/mcp": {
      "type": "local",
      "command": ["npx", "-y", "@magicuidesign/mcp@latest"],
      "description": "Magic UI animated components (marquee, bento, dock, globe, etc.)"
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      },
      "description": "GitHub API — issues, PRs, repos, code search, file management"
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "description": "File system read/write access with path restrictions"
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "description": "Structured reasoning and step-by-step problem solving"
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "description": "Knowledge graph memory for persistent context across sessions"
    },
    "brave-search": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "description": "Web search for documentation, Stack Overflow, and API references"
    },
    "fetch": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-fetch"],
      "description": "Fetch and analyze web content, API docs, and remote resources"
    },
    "puppeteer": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic-ai/mcp-server-puppeteer"],
      "description": "Advanced browser automation, screenshots, and web scraping"
    },
    "sqlite": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic-ai/mcp-server-sqlite", "--db-path", "./data/portfolio.db"],
      "description": "Local SQLite database for caching, analytics, and data analysis"
    },
    "sanity-cms": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic-ai/mcp-server-sanity"],
      "env": {
        "SANITY_PROJECT_ID": "${NEXT_PUBLIC_SANITY_PROJECT_ID}",
        "SANITY_DATASET": "${NEXT_PUBLIC_SANITY_DATASET:-production}",
        "SANITY_AUTH_TOKEN": "${SANITY_AUTH_TOKEN}"
      },
      "description": "Direct Sanity CMS operations, schema management, and content queries"
    },
    "sentry": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic-ai/mcp-server-sentry"],
      "env": {
        "SENTRY_AUTH_TOKEN": "${SENTRY_AUTH_TOKEN}",
        "SENTRY_ORG": "${SENTRY_ORG}"
      },
      "description": "Sentry error tracking and performance monitoring"
    },
    "vercel": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic-ai/mcp-server-vercel"],
      "env": {
        "VERCEL_TOKEN": "${VERCEL_TOKEN}"
      },
      "description": "Vercel deployment, edge functions, and analytics"
    },
    "docker": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic-ai/mcp-server-docker"],
      "description": "Docker container management and optimization"
    }
  },
  "lsp": {
    "typescript": {
      "command": "npx",
      "args": ["-y", "typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx"],
      "initializationOptions": {
        "preferences": {
          "includeInlayParameterNameHints": "all",
          "includeInlayVariableTypeHints": true,
          "includeInlayFunctionLikeReturnTypeHints": true
        }
      }
    },
    "eslint": {
      "command": "npx",
      "args": ["-y", "vscode-eslint-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx"],
      "settings": {
        "validate": "on",
        "packageManager": "npm"
      }
    },
    "prettier": {
      "command": "npx",
      "args": ["-y", "prettier-lsp-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".css", ".scss", ".json", ".md"],
      "initializationOptions": {
        "formatter": {
          "tabWidth": 2,
          "singleQuote": true,
          "trailingComma": "es5",
          "semi": true
        }
      }
    },
    "tailwindcss": {
      "command": "npx",
      "args": ["-y", "@tailwindcss/language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".css", ".scss"],
      "initializationOptions": {
        "emmetCompletions": true
      }
    },
    "html": {
      "command": "npx",
      "args": ["-y", "vscode-html-language-server", "--stdio"],
      "extensions": [".html", ".htm"],
      "initializationOptions": {
        "provideFormatter": true,
        "embeddedLanguages": {
          "css": true,
          "javascript": true
        }
      }
    },
    "css": {
      "command": "npx",
      "args": ["-y", "vscode-css-language-server", "--stdio"],
      "extensions": [".css", ".scss", ".less"],
      "initializationOptions": {
        "provideFormatter": true,
        "validate": true
      }
    },
    "json": {
      "command": "npx",
      "args": ["-y", "vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc", ".json5"],
      "initializationOptions": {
        "provideFormatter": true,
        "validate": true
      }
    },
    "markdown": {
      "command": "npx",
      "args": ["-y", "marksman", "--stdio"],
      "extensions": [".md", ".markdown", ".mdx"],
      "initializationOptions": {
        "markdown": {
          "lint": true
        }
      }
    },
    "graphql": {
      "command": "npx",
      "args": ["-y", "graphql-language-service-cli", "lsp", "--stdio"],
      "extensions": [".graphql", ".gql"],
      "initializationOptions": {
        "schema": "./schema.graphql"
      }
    },
    "yaml": {
      "command": "npx",
      "args": ["-y", "yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"],
      "initializationOptions": {
        "validate": true,
        "completion": true,
        "hover": true
      }
    },
    "dockerfile": {
      "command": "npx",
      "args": ["-y", "dockerfile-language-server-nodejs", "--stdio"],
      "extensions": ["Dockerfile"],
      "initializationOptions": {
        "dockerfile": {
          "lint": true
        }
      }
    },
    "prisma": {
      "command": "npx",
      "args": ["-y", "@prisma/language-server", "--stdio"],
      "extensions": [".prisma"],
      "initializationOptions": {
        "prisma": {
          "lint": true
        }
      }
    }
  }
}