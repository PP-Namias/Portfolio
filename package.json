{
  "name": "pp-namias-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Official personal portfolio of Jhon Keneth Ryan Namias (PP Namias), built with Next.js, TypeScript, Tailwind CSS, and AI-powered chat.",
  "author": "Jhon Keneth Ryan Namias (PP Namias) <pp.namias@gmail.com>",
  "license": "MIT",
  "homepage": "https://namias.tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/PP-Namias/Portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/PP-Namias/Portfolio/issues"
  },
  "keywords": [
    "pp-namias",
    "portfolio",
    "nextjs",
    "typescript",
    "tailwindcss",
    "ai-chatbot"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src studio --ext .ts,.tsx,.js,.jsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "patch-package",
    "cloudflare:build": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:deploy": "opennextjs-cloudflare deploy",
    "sanity:seed": "node ./scripts/sanity/seed-demo.ts",
    "doctor": "react-doctor",
    "doctor:verbose": "react-doctor --verbose",
    "doctor:json": "react-doctor --json > .react-doctor/report.json",
    "doctor:baseline": "react-doctor --json > .react-doctor/baseline.json",
    "doctor:check": "react-doctor --json --fail-on error",
    "doctor:diff": "react-doctor --diff"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sanity/client": "^7.22.1",
    "@upstash/redis": "^1.38.0",
    "framer-motion": "^11.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.577.0",
    "next": "16.2.7",
    "next-sanity": "9.12.3",
    "next-themes": "^0.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@sanity/functions": "^1.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.7",
    "jsdom": "^28.1.0",
    "patch-package": "^8.0.1",
    "react-doctor": "0.4.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.98.0"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
