{
  "name": "pp-namias-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Official personal portfolio of Jhon Keneth Ryan Namias (PP Namias), built with Next.js, TypeScript, Tailwind CSS, and AI-powered chat.",
  "author": "Jhon Keneth Ryan Namias (PP Namias) <pp.namias@gmail.com>",
  "license": "MIT",
  "homepage": "https://namias.tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/PP-Namias/Portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/PP-Namias/Portfolio/issues"
  },
  "keywords": [
    "pp-namias",
    "portfolio",
    "nextjs",
    "typescript",
    "tailwindcss",
    "ai-chatbot"
  ],
  "scripts": {
    "postinstall": "patch-package && npm install --prefix studio",
    "dev": "concurrently --names next,sanity --prefix-colors cyan,magenta \"next dev\" \"npm run dev:studio\"",
    "dev:studio": "cd studio && npm run dev",
    "build": "concurrently --names next,sanity --prefix-colors cyan,magenta --kill-others-on-fail \"next build\" \"npm run build:studio\"",
    "build:studio": "cd studio && npm run build",
    "start": "next start",
    "lint": "eslint src studio --ext .ts,.tsx,.js,.jsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "cloudflare:build": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:deploy": "opennextjs-cloudflare deploy --dangerouslyUseUnsupportedNextVersion",
    "sanity:seed": "node ./scripts/sanity/seed-demo.ts",
    "sanity:migrate": "node ./scripts/sanity-migrate/runner.mjs",
    "sanity:migrate:dry": "node ./scripts/sanity-migrate/runner.mjs --dry-run",
    "sanity:migrate:validate": "node ./scripts/sanity-migrate/runner.mjs --validate-only",
    "sanity:health": "node ./scripts/sanity-migrate/health-report.mjs",
    "doctor": "react-doctor",
    "doctor:verbose": "react-doctor --verbose",
    "doctor:json": "react-doctor --json > .react-doctor/report.json",
    "doctor:baseline": "react-doctor --json > .react-doctor/baseline.json",
    "doctor:check": "react-doctor --json --fail-on error",
    "doctor:diff": "react-doctor --diff"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sanity/client": "^7.26.2",
    "@upstash/redis": "^1.38.2",
    "framer-motion": "^11.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.577.0",
    "next": "16.3.0",
    "next-sanity": "9.12.3",
    "next-themes": "^0.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.5.1",
    "swr": "^2.5.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@sanity/functions": "^1.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "^28.1.0",
    "patch-package": "^8.0.1",
    "react-doctor": "0.9.11",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  },
  "overrides": {
    "postcss": "8.5.10",
    "uuid": "11.1.1",
    "prismjs": "1.30.0"
  }
}
