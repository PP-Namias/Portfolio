# Portfolio V2 - Environment Variables
# Copy to .env.local and fill in values

# === REQUIRED ===
NEXT_PUBLIC_APP_URL=https://namias.tech

# === REQUIRED: GitHub contributions ===
GITHUB_CONTRIBUTIONS_API_URL=https://github-contributions-api.jogruber.de

# === OPTIONAL: GitHub API Token ===
GITHUB_API_TOKEN=

# === OPTIONAL: Registry ===
NEXT_PUBLIC_REGISTRY_NAMESPACE=@pp-namias
NEXT_PUBLIC_REGISTRY_NAMESPACE_URL=https://namias.tech/r/{name}.json

# === OPTIONAL: DMCA ===
NEXT_PUBLIC_DMCA_URL=https://www.dmca.com

# === OPTIONAL: Analytics ===
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_PROJECT_ID=
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=

# === OPTIONAL: Ads ===
ADS_TXT=

# === REQUIRED: Sanity CMS ===
NEXT_PUBLIC_SANITY_PROJECT_ID=nl0qw78w
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
